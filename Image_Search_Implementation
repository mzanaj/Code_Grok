def apply_threshold(scores):
    """Adaptive threshold with guards."""
    base_thresh = config['base_thresholds']['semantic']  # Mode-specific
    filtered = [s for s in scores if s > base_thresh]
    if len(filtered) == 0:
        return scores[:config['min_results']]  # Fallback
    gaps = np.diff(scores)
    valid_gaps = gaps[2:-10] if len(gaps) > 12 else gaps
    cutoff = np.argmax(valid_gaps) + 2 if len(valid_gaps) > 0 else 10
    results = scores[:cutoff]
    results = results[:config['max_results']] if len(results) > config['max_results'] else results
    if len(results) < config['min_results']:
        results = scores[:config['min_results']]
    return results

def fuse_scores(img_scores, txt_scores, bm25_scores):
    """Fusion with normalization or RRF."""
    # Use RRF for simplicity
    ranks = { 'img': {i: rank for rank, i in enumerate(img_scores.argsort()[::-1])},
              'txt': {i: rank for rank, i in enumerate(txt_scores.argsort()[::-1]) if txt_scores is not None else {}},
              'bm25': {i: rank for rank, i in enumerate(bm25_scores.argsort()[::-1]) if bm25_scores is not None else {}} }
    fused = {}
    for i in set(list(ranks['img'].keys()) + list(ranks['txt'].keys()) + list(ranks['bm25'].keys())):
        score = sum(1 / (rank + 60) for rank in [ranks.get(src, {}).get(i, 60) for src in ['img', 'txt', 'bm25']])
        fused[i] = score
    return sorted(fused.items(), key=lambda x: x[1], reverse=True)

