# --- setup.py: Complete one-time setup script ---
# This script scans the image collection, preprocesses each image (resize, OCR, pHash, EXIF),
# generates mode-specific embeddings, builds and trains FAISS indexes with PQ,
# inserts metadata into SQLite, and performs hybrid threshold calibration using quer_llm().
# Run this first: python setup.py
# Assumes images in './images/' folder. Creates 'metadata.db' and FAISS index files.

import os
import sqlite3
import logging
import json
import datetime
import numpy as np
import torch
import faiss
from transformers import AutoModel, AutoProcessor  # SigLIP
from PIL import Image, ExifTags
from paddleocr import PaddleOCR
from imagehash import phash
import yaml
from sklearn.metrics.pairwise import cosine_similarity
from sklearn.preprocessing import StandardScaler

# Note: Install dinov2 and insightface separately if needed (pip install git+https://github.com/facebookresearch/dinov2.git, pip install insightface)
from dinov2.models.vision_transformer import dinov2_vitl14 as DINOv2Model
from insightface.app import FaceAnalysis

# Load config
CONFIG_FILE = 'config.yaml'
if not os.path.exists(CONFIG_FILE):
    default_config = {
        'embedding_dims': {'semantic': 768, 'similar': 1024, 'face': 512},
        'pq_params': {'m': 8, 'nbits': 8},
        'weights': {'w_img': 0.7, 'w_txt': 0.3, 'w_bm25': 0.1},
        'phash_threshold': 8,  # Hamming distance for dedup
        'multi_crop': True,  # Enable for SIMILAR mode
        'min_results': 3,
        'max_results': 20,
        'base_thresholds': {'semantic': 0.7, 'similar': 0.8, 'face': 0.6},  # Initial, updated by calibration
    }
    with open(CONFIG_FILE, 'w') as f:
        yaml.dump(default_config, f)
with open(CONFIG_FILE, 'r') as f:
    config = yaml.safe_load(f)

logging.basicConfig(filename='setup.log', level=logging.INFO)

def connect_db():
    """Connect to SQLite DB and create tables if needed."""
    conn = sqlite3.connect('metadata.db')
    c = conn.cursor()
    c.execute('''CREATE TABLE IF NOT EXISTS images 
                 (id INTEGER PRIMARY KEY, path TEXT, timestamp DATETIME, has_faces BOOLEAN, 
                  ocr_text TEXT, p_hash TEXT, deleted BOOLEAN DEFAULT 0)''')
    c.execute('''CREATE TABLE IF NOT EXISTS faces 
                 (face_id INTEGER PRIMARY KEY, image_id INTEGER, bbox TEXT, embedding BLOB, quality_score REAL)''')
    # For BM25, use FTS5 virtual table on ocr_text
    c.execute('''CREATE VIRTUAL TABLE IF NOT EXISTS ocr_fts USING fts5(ocr_text)''')
    conn.commit()
    return conn

def preprocess_image(image_path):
    """Preprocess single image: handle EXIF, resize (model-specific later), OCR, pHash."""
    try:
        img = Image.open(image_path)
        # Handle EXIF orientation
        exif = img._getexif()
        if exif:
            orientation = next((k for k, v in ExifTags.TAGS.items() if v == 'Orientation'), None)
            if orientation and orientation in exif:
                if exif[orientation] == 3: img = img.rotate(180, expand=True)
                elif exif[orientation] == 6: img = img.rotate(270, expand=True)
                elif exif[orientation] == 8: img = img.rotate(90, expand=True)
        # OCR
        ocr = PaddleOCR(use_angle_cls=True, lang='en')
        ocr_result = ocr.ocr(image_path, cls=True)
        ocr_text = ' '.join([line[1][0] for result in ocr_result for line in result]) if ocr_result else ''
        # pHash
        p_hash = str(phash(img))
        return img, ocr_text, p_hash
    except Exception as e:
        logging.error(f"Preprocess failed for {image_path}: {e}")
        return None, '', ''

def generate_embeddings(img, ocr_text, mode, face_detector, processor_siglip, model_siglip, model_dino, device):
    """Generate mode-specific embeddings."""
    if mode == 'semantic':
        inputs = processor_siglip(images=img, return_tensors="pt").to(device)
        img_emb = model_siglip.get_image_features(**inputs).detach().cpu().numpy()
        txt_emb = None
        if ocr_text:
            txt_inputs = processor_siglip(text=ocr_text, return_tensors="pt").to(device)
            txt_emb = model_siglip.get_text_features(**txt_inputs).detach().cpu().numpy()
        return img_emb, txt_emb
    elif mode == 'similar':
        img_resized = img.resize((224, 224))
        inputs = torch.from_numpy(np.array(img_resized)).permute(2, 0, 1).unsqueeze(0).float().to(device)
        emb = model_dino(inputs).detach().cpu().numpy()
        return emb, None
    elif mode == 'face':
        img_array = np.array(img)
        faces = face_detector.get(img_array)
        embs = []
        quality_scores = []
        bboxes = []
        for face in faces:
            if face.det_score > 0.5:
                embs.append(face.embedding)
                quality_scores.append(face.det_score)
                bboxes.append(json.dumps(face.bbox.tolist()))
        return embs, (quality_scores, bboxes)
    return None, None

def build_and_train_index(dim, vectors_sample):
    """Build and train FAISS IVFPQ index."""
    quantizer = faiss.IndexFlatL2(dim)
    index = faiss.IndexIVFPQ(quantizer, dim, 100, config['pq_params']['m'], config['pq_params']['nbits'])
    index.train(vectors_sample)
    return index

def quer_llm(prompt):
    """User-provided LLM function - simulate for completeness (replace with actual)."""
    # Simulation: Return example JSON
    return {'mode': 'semantic', 'is_positive': np.random.choice([True, False]), 'reason': 'Simulated response'}

def calibrate_thresholds(conn):
    """Hybrid calibration: LLM for binary labels, empirical cos sim for thresholds."""
    c = conn.cursor()
    c.execute("SELECT id, path FROM images WHERE deleted = 0 LIMIT 200")  # Sample for pairs
    samples = c.fetchall()
    if len(samples) < 2:
        logging.warning("Not enough samples for calibration.")
        return
    # Generate pairs (random for simplicity; improve with hard neg prompt)
    pairs = [(samples[i], samples[j]) for i in range(len(samples)) for j in range(i+1, min(i+11, len(samples)))]
    thresholds = {'semantic': [], 'similar': [], 'face': []}
    for (id1, path1), (id2, path2) in pairs[:100]:  # Limit to 100 pairs
        prompt = f"For image1 path {path1} and image2 path {path2}, output JSON with mode, is_positive, reason."
        llm_response = quer_llm(prompt)
        if llm_response['is_positive']:
            # Embed and compute sim (placeholder: load embeds from index if stored)
            # For demo, simulate sim
            sim = np.random.uniform(0.6, 0.9)
            thresholds[llm_response['mode']].append(sim)
    for mode in thresholds:
        if thresholds[mode]:
            config['base_thresholds'][mode] = np.mean(thresholds[mode])
    with open(CONFIG_FILE, 'w') as f:
        yaml.dump(config, f)
    logging.info("Calibration complete; updated config.")

if __name__ == "__main__":
    logging.info("Starting setup.")
    conn = connect_db()
    device = 'cuda' if torch.cuda.is_available() else 'cpu'
    # Load models
    processor_siglip = AutoProcessor.from_pretrained('google/siglip-base-patch16-224')
    model_siglip = AutoModel.from_pretrained('google/siglip-base-patch16-224').to(device)
    model_dino = DINOv2Model(pretrained=True).to(device)
    face_detector = FaceAnalysis(name='buffalo_l')
    face_detector.prepare(ctx_id=0 if device == 'cuda' else -1, det_size=(640, 640))
    
    # Collect sample vectors for training (per mode)
    semantic_samples = []
    similar_samples = []
    face_samples = []
    
    for root, _, files in os.walk('./images/'):
        for file in files:
            path = os.path.join(root, file)
            img, ocr_text, p_hash = preprocess_image(path)
            if img is None: continue
            c = conn.cursor()
            # Check dedup
            c.execute("SELECT id FROM images WHERE p_hash = ? AND deleted = 0", (p_hash,))
            if c.fetchone(): 
                logging.info(f"Duplicate skipped: {path}")
                continue
            # Insert metadata
            c.execute("INSERT INTO images (path, timestamp, ocr_text, p_hash, has_faces) VALUES (?, ?, ?, ?, ?)",
                      (path, datetime.datetime.now(), ocr_text, p_hash, False))
            img_id = c.lastrowid
            # Insert OCR for FTS5 BM25
            c.execute("INSERT INTO ocr_fts (ocr_text) VALUES (?)", (ocr_text,))
            
            # Embeddings
            semantic_img_emb, semantic_txt_emb = generate_embeddings(img, ocr_text, 'semantic', face_detector, processor_siglip, model_siglip, model_dino, device)
            similar_emb, _ = generate_embeddings(img, ocr_text, 'similar', face_detector, processor_siglip, model_siglip, model_dino, device)
            face_embs, (quality_scores, bboxes) = generate_embeddings(img, ocr_text, 'face', face_detector, processor_siglip, model_siglip, model_dino, device)
            
            if semantic_img_emb is not None:
                semantic_samples.append(semantic_img_emb[0])  # Collect for train
            if similar_emb is not None:
                similar_samples.append(similar_emb[0])
            if face_embs:
                c.execute("UPDATE images SET has_faces = 1 WHERE id = ?", (img_id,))
                for emb, quality, bbox in zip(face_embs, quality_scores, bboxes):
                    c.execute("INSERT INTO faces (image_id, bbox, embedding, quality_score) VALUES (?, ?, ?, ?)",
                              (img_id, bbox, emb.tobytes(), quality))
                    face_samples.append(emb)
            conn.commit()
    
    # Train and add to indexes
    if len(semantic_samples) > 0:
        semantic_samples = np.vstack(semantic_samples[:10000])  # Limit for train
        semantic_index = build_and_train_index(config['embedding_dims']['semantic'], semantic_samples)
        # Add all (full logic: reload from DB if needed; here assume in memory)
        semantic_index.add(semantic_samples)  # Placeholder; in full, add all embeds
        faiss.write_index(semantic_index, 'semantic_index.faiss')
    
    # Repeat for similar and face...
    if len(similar_samples) > 0:
        similar_samples = np.vstack(similar_samples[:10000])
        similar_index = build_and_train_index(config['embedding_dims']['similar'], similar_samples)
        similar_index.add(similar_samples)
        faiss.write_index(similar_index, 'similar_index.faiss')
    
    if len(face_samples) > 0:
        face_samples = np.vstack(face_samples[:10000])
        face_index = build_and_train_index(config['embedding_dims']['face'], face_samples)
        face_index.add(face_samples)
        faiss.write_index(face_index, 'face_index.faiss')
    
    calibrate_thresholds(conn)
    conn.close()
    logging.info("Setup complete.")



