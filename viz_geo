# Cache data generation to avoid regenerating on each interaction
@st.cache_data
def generate_sample_data(n_points=100000):
    """Generate sample geo data with a z column for coloring"""
    np.random.seed(42)
    
    # Generate points across the US (roughly)
    data = pd.DataFrame({
        'lat': np.random.uniform(25, 49, n_points),
        'lon': np.random.uniform(-125, -65, n_points),
        'z': np.random.uniform(0, 100, n_points)  # Value for coloring
    })
    
    return data

def get_color_from_z(z_value, z_min, z_max, colormap='viridis'):
    """Convert z value to RGB color based on colormap"""
    # Normalize z to 0-1
    normalized = (z_value - z_min) / (z_max - z_min) if z_max > z_min else 0
    
    # Simple colormaps (you can expand this)
    if colormap == 'viridis':
        # Simplified viridis approximation
        r = int(255 * (0.267 + normalized * 0.329))
        g = int(255 * (0.005 + normalized * 0.880))
        b = int(255 * (0.329 + normalized * 0.545))
    elif colormap == 'plasma':
        r = int(255 * (0.050 + normalized * 0.900))
        g = int(255 * (0.030 + normalized * 0.670))
        b = int(255 * (0.528 - normalized * 0.428))
    elif colormap == 'inferno':
        r = int(255 * normalized)
        g = int(255 * normalized * 0.8)
        b = int(255 * (0.4 - normalized * 0.3))
    else:  # default red-blue
        r = int(255 * normalized)
        g = int(100)
        b = int(255 * (1 - normalized))
    
    return [r, g, b, 200]  # RGBA

