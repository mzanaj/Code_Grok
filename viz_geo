import math
import numpy as np
import pandas as pd
import streamlit as st
import pydeck as pdk

# -----------------------------
# Base map styles (multiple)
# -----------------------------
CARTO_STYLES = {
    "CARTO Positron (light, no token)": "https://basemaps.cartocdn.com/gl/positron-gl-style/style.json",
    "CARTO Dark Matter (dark, no token)": "https://basemaps.cartocdn.com/gl/dark-matter-gl-style/style.json",
    "CARTO Voyager (no token)": "https://basemaps.cartocdn.com/gl/voyager-gl-style/style.json",
}

MAPBOX_STYLES = {
    "Mapbox Light (token required)": "mapbox://styles/mapbox/light-v11",
    "Mapbox Dark (token required)": "mapbox://styles/mapbox/dark-v11",
    "Mapbox Streets (token required)": "mapbox://styles/mapbox/streets-v12",
    "Mapbox Satellite (token required)": "mapbox://styles/mapbox/satellite-v9",
}

# -----------------------------
# Utilities
# -----------------------------
def _validate_df(df: pd.DataFrame) -> pd.DataFrame:
    req = {"lat", "lon", "z"}
    missing = req - set(df.columns)
    if missing:
        raise ValueError(f"DataFrame missing columns: {missing}. Required: lat, lon, z")

    # Ensure numeric + drop bad rows
    out = df[["lat", "lon", "z"]].copy()
    out["lat"] = pd.to_numeric(out["lat"], errors="coerce")
    out["lon"] = pd.to_numeric(out["lon"], errors="coerce")
    out["z"] = pd.to_numeric(out["z"], errors="coerce")
    out = out.dropna()
    # Optional clamp to valid ranges
    out = out[(out["lat"].between(-90, 90)) & (out["lon"].between(-180, 180))]
    return out

def _meters_per_pixel(lat: float, zoom: float) -> float:
    # Web Mercator approximate at given latitude
    return 156543.03392 * math.cos(math.radians(lat)) / (2 ** zoom)

def _viewport_bbox(center_lat: float, center_lon: float, zoom: float, width_px: int, height_px: int):
    # Convert viewport pixels to degrees using meters/pixel approximation
    mpp = _meters_per_pixel(center_lat, zoom)

    half_w_m = (width_px / 2) * mpp
    half_h_m = (height_px / 2) * mpp

    meters_per_deg_lat = 111320.0
    meters_per_deg_lon = 111320.0 * max(0.1, math.cos(math.radians(center_lat)))

    dlat = half_h_m / meters_per_deg_lat
    dlon = half_w_m / meters_per_deg_lon

    return (center_lat - dlat, center_lat + dlat, center_lon - dlon, center_lon + dlon)

def _bin_size_degrees_for_zoom(zoom: float) -> float:
    # Tune these for your data density; smaller bins at higher zoom
    if zoom <= 5:
        return 0.20
    if zoom <= 7:
        return 0.10
    if zoom <= 9:
        return 0.05
    if zoom <= 11:
        return 0.02
    if zoom <= 13:
        return 0.01
    return 0.005

def _make_colormap_stops(name: str):
    # Compact color stop sets (RGB). You can add more palettes as needed.
    palettes = {
        "viridis": [
            (68, 1, 84), (59, 82, 139), (33, 145, 140), (94, 201, 98), (253, 231, 37)
        ],
        "plasma": [
            (13, 8, 135), (126, 3, 168), (203, 71, 119), (248, 149, 64), (240, 249, 33)
        ],
        "magma": [
            (0, 0, 4), (74, 16, 111), (144, 54, 128), (210, 109, 84), (252, 253, 191)
        ],
        "cividis": [
            (0, 32, 76), (40, 73, 120), (90, 110, 116), (150, 152, 101), (232, 229, 95)
        ],
    }
    return palettes.get(name, palettes["viridis"])

def _interpolate_color(t: float, stops):
    # t in [0,1]
    t = float(np.clip(t, 0.0, 1.0))
    n = len(stops)
    if n == 1:
        return list(stops[0])
    x = t * (n - 1)
    i = int(np.floor(x))
    j = min(i + 1, n - 1)
    frac = x - i
    c0 = np.array(stops[i], dtype=float)
    c1 = np.array(stops[j], dtype=float)
    c = (1 - frac) * c0 + frac * c1
    return [int(c[0]), int(c[1]), int(c[2])]

def _apply_palette(values: np.ndarray, vmin: float, vmax: float, palette: str, rotate: float):
    # rotate shifts palette indexing; rotate in [0,1)
    stops = _make_colormap_stops(palette)
    denom = (vmax - vmin) if vmax > vmin else 1.0
    t = (values - vmin) / denom
    t = (t + rotate) % 1.0
    colors = np.array([_interpolate_color(x, stops) for x in t], dtype=np.int16)
    return colors

@st.cache_data(show_spinner=False)
def _aggregate_grid(df: pd.DataFrame, bin_size_deg: float) -> pd.DataFrame:
    """
    Server-side aggregation to reduce payload dramatically when zoomed out.
    Produces one row per bin with mean z + count.
    """
    # Bin ids
    lon_bin = np.floor(df["lon"].to_numpy() / bin_size_deg).astype(np.int64)
    lat_bin = np.floor(df["lat"].to_numpy() / bin_size_deg).astype(np.int64)

    tmp = df.copy()
    tmp["_lon_bin"] = lon_bin
    tmp["_lat_bin"] = lat_bin

    g = tmp.groupby(["_lon_bin", "_lat_bin"], sort=False, observed=True)
    out = g.agg(
        lon=("lon", "mean"),
        lat=("lat", "mean"),
        z_mean=("z", "mean"),
        count=("z", "size"),
    ).reset_index(drop=True)

    return out

def _legend_html(vmin: float, vmax: float, palette: str, rotate: float):
    stops = _make_colormap_stops(palette)
    # Build 12-swatch legend
    swatches = []
    for k in range(12):
        t = (k / 11.0 + rotate) % 1.0
        rgb = _interpolate_color(t, stops)
        swatches.append(f'<div style="flex:1;height:10px;background:rgb({rgb[0]},{rgb[1]},{rgb[2]});"></div>')
    return f"""
    <div style="font-family:system-ui, -apple-system, Segoe UI, Roboto, sans-serif; font-size:12px;">
      <div style="display:flex; gap:0; border-radius:6px; overflow:hidden; border:1px solid rgba(0,0,0,0.15);">
        {''.join(swatches)}
      </div>
      <div style="display:flex; justify-content:space-between; margin-top:4px; opacity:0.85;">
        <span>{vmin:.3g}</span><span>{vmax:.3g}</span>
      </div>
    </div>
    """

# -----------------------------
# Main render function
# -----------------------------
def render_pydeck_geo_viz(
    df: pd.DataFrame,
    *,
    title: str = "Geo Points",
    initial_zoom: float | None = None,
    initial_center: tuple[float, float] | None = None,
    max_points_frontend: int = 250_000,
    default_width_px: int = 1200,
    default_height_px: int = 700,
):
    """
    Drop-in Streamlit component.

    df must have columns: lat, lon, z
    """
    df = _validate_df(df)

    if initial_center is None:
        center_lat = float(df["lat"].median())
        center_lon = float(df["lon"].median())
    else:
        center_lat, center_lon = float(initial_center[0]), float(initial_center[1])

    if initial_zoom is None:
        initial_zoom = 9.0

    st.subheader(title)

    # Controls
    c1, c2, c3, c4 = st.columns([1.3, 1.0, 1.0, 1.0])
    with c1:
        basemap_choice = st.selectbox(
            "Base layer",
            options=list(CARTO_STYLES.keys()) + list(MAPBOX_STYLES.keys()),
            index=0,
        )
    with c2:
        palette = st.selectbox("Palette", ["viridis", "plasma", "magma", "cividis"], index=0)
    with c3:
        rotate = st.slider("Legend rotate", 0.0, 0.999, 0.0, 0.01)
    with c4:
        opacity = st.slider("Opacity", 0.1, 1.0, 0.75, 0.05)

    c5, c6, c7, c8 = st.columns([1.0, 1.0, 1.0, 1.0])
    with c5:
        zoom = st.slider("Zoom", 1.0, 17.0, float(initial_zoom), 0.5)
    with c6:
        width_px = st.number_input("Viewport width (px)", 400, 2400, int(default_width_px), 50)
    with c7:
        height_px = st.number_input("Viewport height (px)", 300, 1400, int(default_height_px), 50)
    with c8:
        z_clip = st.slider("Z clip (percentile)", 0, 20, 2, 1)

    # Pick basemap style URL
    map_style = CARTO_STYLES.get(basemap_choice) or MAPBOX_STYLES.get(basemap_choice)

    # Compute z-range for coloring (clipped for stability)
    z_lo, z_hi = np.percentile(df["z"].to_numpy(), [z_clip, 100 - z_clip])
    if not np.isfinite(z_lo) or not np.isfinite(z_hi) or z_hi <= z_lo:
        z_lo, z_hi = float(df["z"].min()), float(df["z"].max())
        if z_hi <= z_lo:
            z_hi = z_lo + 1.0

    # Decide LOD: aggregate when zoomed out, raw viewport points when zoomed in
    zoom_threshold_for_raw = 12.0
    if zoom < zoom_threshold_for_raw:
        # Aggregated grid
        bin_deg = _bin_size_degrees_for_zoom(zoom)
        agg = _aggregate_grid(df, bin_deg)

        # Color by z_mean
        colors = _apply_palette(agg["z_mean"].to_numpy(), z_lo, z_hi, palette, rotate)
        agg = agg.assign(color=colors.tolist())

        # Radius in meters-ish: scale with zoom so bins look reasonable
        # A rough conversion: degrees -> meters at equator; acceptable for visualization
        radius_m = max(40, int(bin_deg * 111320 * 0.45))

        layer = pdk.Layer(
            "ScatterplotLayer",
            data=agg,
            get_position='[lon, lat]',
            get_radius=radius_m,
            radius_min_pixels=2,
            radius_max_pixels=40,
            get_fill_color="color",
            get_line_color=[0, 0, 0],
            line_width_min_pixels=0,
            opacity=float(opacity),
            pickable=True,
        )

        tooltip = {
            "text": "z_mean: {z_mean}\ncount: {count}"
        }

    else:
        # Raw points but viewport-filtered to avoid shipping all 1M rows
        lat_min, lat_max, lon_min, lon_max = _viewport_bbox(center_lat, center_lon, zoom, int(width_px), int(height_px))
        view_df = df[(df["lat"].between(lat_min, lat_max)) & (df["lon"].between(lon_min, lon_max))]

        # If still huge, cap it (keeps socket + browser safe)
        if len(view_df) > max_points_frontend:
            view_df = view_df.sample(max_points_frontend, random_state=42)

        colors = _apply_palette(view_df["z"].to_numpy(), z_lo, z_hi, palette, rotate)
        view_df = view_df.assign(color=colors.tolist())

        layer = pdk.Layer(
            "ScatterplotLayer",
            data=view_df,
            get_position='[lon, lat]',
            get_radius=6,
            radius_min_pixels=2,
            radius_max_pixels=10,
            get_fill_color="color",
            opacity=float(opacity),
            pickable=True,
        )
        tooltip = {"text": "z: {z}"}

        st.caption(f"Viewport points: {len(view_df):,} (filtered from {len(df):,})")

    # Legend
    st.markdown(_legend_html(float(z_lo), float(z_hi), palette, rotate), unsafe_allow_html=True)

    deck = pdk.Deck(
        layers=[layer],
        initial_view_state=pdk.ViewState(
            latitude=center_lat,
            longitude=center_lon,
            zoom=float(zoom),
            pitch=40,
        ),
        map_style=map_style,
        tooltip=tooltip,
    )

    # The chart itself
    st.pydeck_chart(deck, use_container_width=True)
