    # "Rotating" / Dynamic Legend Selection
    color_palette = st.selectbox("Color Legend (Column Z)", ["viridis", "plasma", "inferno", "magma"])
    point_radius = st.slider("Point Size", 1, 50, 5)

# --- 3. PRE-CALCULATE COLORS (Efficiency Step) ---
# Mapping Z values to RGB in Python is 10x faster than letting the JS engine do it
cmap = colormaps.get_cmap(color_palette)
colors = (cmap(data['z'])[:, :3] * 255).astype(np.uint8)
data['r'], data['g'], data['b'] = colors[:, 0], colors[:, 1], colors[:, 2]

# --- 4. PYDECK LAYER DEFINITION ---
layer = pdk.Layer(
    "ScatterplotLayer",
    data,
    get_position="[lon, lat]",
    # Referencing the pre-calculated r, g, b columns
    get_fill_color="[r, g, b, 150]", 
    get_radius=point_radius,
    pickable=True,
)

# --- 5. THE MAP ---
view_state = pdk.ViewState(latitude=37.76, longitude=-122.4, zoom=11, pitch=45)

st.pydeck_chart(pdk.Deck(
    map_style=f"mapbox://styles/mapbox/{map_style}-v9",
    initial_view_state=view_state,
    layers=[layer],
    tooltip={"text": "Value: {z}"}
))

