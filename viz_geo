# For animated legend, we'll rotate the z-value threshold
if animate_legend and 'animation_offset' not in st.session_state:
    st.session_state.animation_offset = 0

# Create color column efficiently using vectorized operations
if animate_legend:
    # Rotate the z values by adding offset (creates rotating color effect)
    offset = st.session_state.animation_offset
    df_display = df.copy()
    df_display['z_rotated'] = (df['z'] + offset) % 100
    df_display['color'] = df_display['z_rotated'].apply(
        lambda z: get_color_from_z(z, z_min, z_max, colormap)
    )
else:
    df_display = df.copy()
    df_display['color'] = df['z'].apply(
        lambda z: get_color_from_z(z, z_min, z_max, colormap)
    )

# Create pydeck layer
layer = pdk.Layer(
    'ScatterplotLayer',
    data=df_display,
    get_position=['lon', 'lat'],
    get_color='color',
