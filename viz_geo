# Legend
st.sidebar.markdown("---")
st.sidebar.subheader("Legend")
legend_steps = 10
for i in range(legend_steps):
    z_val = z_min + (z_max - z_min) * i / (legend_steps - 1)
    color = get_color_from_z(z_val, z_min, z_max, colormap)
